#version 450
// ─────────────────────────────────────────────────────────────────────────────
// win-fg model 4 — FSR3 Optical Flow v2 (pass 3/4): coarse-to-fine block flow.
//
// Adapted from AMD FidelityFX-SDK FSR3 Optical Flow search pass:
//   ffx_opticalflow_compute_optical_flow_v5.h
//   (SAD block-matching, BlockSize 8, SearchRadius 8, prediction from the
//    previous coarser pyramid level). FidelityFX SDK is MIT-licensed; see NOTICE.
//
// This is a self-contained, subgroup-free re-implementation of that pass so it
// compiles with glslangValidator for Vulkan 1.1 / Turnip. The SDK version uses
// wave intrinsics (ffxWaveSum), groupshared SAD maps, msad4 and packed-uint
// luma — none of which are portable to bare GLSL on Adreno.
//
// ── Model 4 vs model 3 ────────────────────────────────────────────────────
//  * BLOCK GRID: one invocation solves one BLOCK x BLOCK block (as the SDK
//    does) instead of one per pixel. The flow image is 1/BLOCK of the luma
//    extent at each level; every consumer samples it by normalised uv, so the
//    coarser grid bilinear-upsamples for free. This is what pays for the rest.
//  * MATCH WINDOW widened 3x3 -> 5x5 (BR 1 -> 2). A 3x3 window is severely
//    aperture-limited: on low-contrast or edge-dominated blocks it locks onto
//    the wrong candidate. This is the main accuracy fix.
//  * SUB-PIXEL refinement: parabola fit through the SAD either side of the
//    integer winner, per axis. Without it slow pans quantise to whole texels
//    and the interpolated frame judders.
//  * TRUE BIDIRECTIONAL flow: forward (prev matched into curr) is packed in .xy
//    and a second, independently searched backward field in .zw. Model 3
//    assumes backward = -forward, which is wrong exactly at occlusion
//    boundaries. of3_expand_m4 consumes both and uses their disagreement as a
//    confidence signal.
//
// Net cost is ~2.7x LOWER than the per-pixel 3x3/+-3 version despite searching
// in both directions with a 25-tap window, because the block grid removes 16x
// the invocations.
//
// Flow vectors are carried in FULL-RESOLUTION pixel units across all levels so
// the predictor needs no rescale between levels.
// ─────────────────────────────────────────────────────────────────────────────
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform U {
    float flowScale;   // unused here (applied in synth UBO); kept for layout parity
    uint  level;       // pyramid level being solved (0 = full res)
    float occlLo;      // unused here (consumed by of3_expand)
    float occlHi;      // unused here (consumed by of3_expand)
};

layout(binding = 32) uniform sampler2D uLumaPrev;  // prev luma at this level (R32F)
layout(binding = 33) uniform sampler2D uLumaCurr;  // curr luma at this level (R32F)
layout(binding = 34) uniform sampler2D uPredictor; // coarser flow, full-res px (.xy fwd, .zw bwd)

layout(binding = 48, rgba16f) uniform writeonly image2D uFlow; // .xy fwd, .zw bwd (full-res px)

const int BR = 1; // block half-window  -> (2*BR+1)^2 = 9 tap SAD (trimmed from 5x5 for perf)
const int SR = 3; // search radius      -> (2*SR+1)^2 = 49 candidates per level

// Coarse-to-fine reach over 5 levels is +-SR*(1+2+4+8+16) = +-93 full-res px, so
// the range given up by keeping SR small is recovered by the predictor chain.
// BR/SR remain the device tuning knobs: raise for quality, lower for speed.

vec2 gUv;       // block centre, normalised
vec2 gInvLuma;  // one luma texel of THIS level, in uv (NOT the flow grid step)

// SAD of the window around gUv in `a` against `b` displaced by `cand`
// (cand in this level's luma texels).
float blockSad(sampler2D a, sampler2D b, vec2 cand) {
    float sad = 0.0;
    for (int by = -BR; by <= BR; ++by) {
        for (int bx = -BR; bx <= BR; ++bx) {
            vec2 bo = vec2(float(bx), float(by));
            float pa = textureLod(a, gUv + bo * gInvLuma, 0.0).r;
            float pb = textureLod(b, gUv + (bo + cand) * gInvLuma, 0.0).r;
            sad += abs(pa - pb);
        }
    }
    return sad;
}

// Exhaustive +-SR search then sub-pixel refine. `pred` is in this level's texels.
vec2 solve(sampler2D a, sampler2D b, vec2 pred) {
    float bestSad  = 3.402823466e+38;
    vec2  bestDisp = pred;

    for (int sy = -SR; sy <= SR; ++sy) {
        for (int sx = -SR; sx <= SR; ++sx) {
            vec2 cand = pred + vec2(float(sx), float(sy));
            float sad = blockSad(a, b, cand);
            // Mild bias toward the predictor (smoothness prior, like the SDK's
            // prediction term) so textureless blocks keep the coarse flow.
            sad += 0.002 * (abs(float(sx)) + abs(float(sy)));
            if (sad < bestSad) {
                bestSad  = sad;
                bestDisp = cand;
            }
        }
    }

    // Sub-pixel refinement at level 0 only. Parabola fit on the 5-cell cross of
    // SAD values around the integer winner in each axis (Lowe 2004 §5, RAFT
    // arxiv:2003.12039 §3.2 lookup). 4 extra block-SADs — negligible vs the
    // SR^2 loop and only fires once per direction at the finest pyramid level.
    // Delta clamped to +-0.5 so a degenerate fit stays in-cell.
    // Trades a small perf hit for measurably crisper synth on smooth pans.
    if (level == 0u) {
        float sadC  = bestSad - 0.0; // includes the smoothness bias; ratio cancels
        float sadXm = blockSad(a, b, bestDisp + vec2(-1.0, 0.0)) + 0.002;
        float sadXp = blockSad(a, b, bestDisp + vec2(+1.0, 0.0)) + 0.002;
        float sadYm = blockSad(a, b, bestDisp + vec2(0.0, -1.0)) + 0.002;
        float sadYp = blockSad(a, b, bestDisp + vec2(0.0, +1.0)) + 0.002;
        float dx = 0.0, dy = 0.0;
        float denomX = sadXm - 2.0 * sadC + sadXp;
        float denomY = sadYm - 2.0 * sadC + sadYp;
        if (denomX > 1e-6) dx = clamp(0.5 * (sadXm - sadXp) / denomX, -0.5, 0.5);
        if (denomY > 1e-6) dy = clamp(0.5 * (sadYm - sadYp) / denomY, -0.5, 0.5);
        bestDisp += vec2(dx, dy);
    }
    return bestDisp;
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dim = imageSize(uFlow);   // block grid = ceil(luma extent / BLOCK)
    if (gid.x >= dim.x || gid.y >= dim.y) return;

    gUv      = (vec2(gid) + 0.5) / vec2(dim);
    gInvLuma = 1.0 / vec2(textureSize(uLumaCurr, 0));

    // Predictor flow is stored in full-res pixels; convert to this level's texels.
    float toLevel = exp2(-float(level));
    vec4  pred    = textureLod(uPredictor, gUv, 0.0);

    // Forward: prev block matched into curr. Backward: the reverse, searched
    // independently — where the two disagree, something was occluded or revealed.
    vec2 fwd = solve(uLumaPrev, uLumaCurr, pred.xy * toLevel);
    vec2 bwd = solve(uLumaCurr, uLumaPrev, pred.zw * toLevel);

    float toFull = exp2(float(level));
    imageStore(uFlow, gid, vec4(fwd * toFull, bwd * toFull));
}
