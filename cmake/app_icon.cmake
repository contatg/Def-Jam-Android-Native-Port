# defjam_app_icon(<target>)
# Embeds the 128x128 window icon (branding/icon/window/*.rgba, raw RGBA) in <target> as
# app_icon_rgba[], for SDL_SetWindowIcon. The Windows build gets its icon from the .rc instead.
function(defjam_app_icon target)
    if(APPLE)
        set(source "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../branding/icon/window/window-128-macos.rgba")
    else()
        set(source "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../branding/icon/window/window-128.rgba")
    endif()
    cmake_path(NORMAL_PATH source)
    if(NOT EXISTS "${source}")
        message(FATAL_ERROR "Missing ${source}; it is tracked in the repository (branding/)")
    endif()
    file(READ "${source}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    set(header "${CMAKE_CURRENT_BINARY_DIR}/app_icon_rgba.h")
    set(text "/* Generated by cmake/app_icon.cmake from ${source}. */
#define APP_ICON_SIZE 128
static const unsigned char app_icon_rgba[] = {${bytes}};
")
    set(previous "")
    if(EXISTS "${header}")
        file(READ "${header}" previous)
    endif()
    if(NOT previous STREQUAL text)
        file(WRITE "${header}" "${text}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
endfunction()
