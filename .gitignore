# ---- NEVER commit game data: the user supplies their own dump ----
*.iso
*.xiso
*.xiso.iso
*.xbe
*.7z
*.zip
*.rar
private/
src/recomp/gen/**
src/recomp/gen-pending-*/
!src/recomp/gen/.gitkeep
game/assets/
assets/
extracted/

# ---- build output ----
build/
out/
android/.gradle/
android/app/build/
android/vendor/*
!android/vendor/.gitkeep
cmake-build-*/
*.obj
*.o
*.pdb
*.ilk
*.exe
*.dll
*.so
*.a
*.lib

# ---- editors / OS ----
.vs/
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# ---- python ----
__pycache__/
*.pyc
.venv/

# ---- local junction to the extracted disc (never committed) ----
/game/
# the same name as a symlink, which is how the folder is linked off Windows
/game

# ---- runtime logs ----
logs/
*.log

# ---- rendered frames are game artwork; captures stay local ----
*.bmp
*.ppm
tests/golden/*.png

# ---- personal agent settings (the shared .claude/skills, .claude/agents, .codex/skills are generated and tracked) ----
.claude/settings.local.json
CLAUDE.local.md

# Android loader source snapshots (licenses kept; no built libraries)
!android/vendor/volk/
!android/vendor/volk/**
!android/vendor/libadrenotools/
!android/vendor/libadrenotools/**
!android/vendor/THIRD-PARTY-NOTICES.txt
