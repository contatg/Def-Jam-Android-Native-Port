{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "win-x64-debug",
      "displayName": "Windows x64 Debug (Ninja + MSVC)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DEFJAM_VERBOSE_KERNEL": "ON"
      }
    },
    {
      "name": "win-x64-abicheck",
      "displayName": "Windows x64 Debug with the callee-saved register check",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DEFJAM_VERBOSE_KERNEL": "ON",
        "DEFJAM_ABI_CHECK": "ON"
      }
    },
    {
      "name": "win-x64-release",
      "displayName": "Windows x64 Release (Ninja + MSVC)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "win-vs2022",
      "displayName": "Visual Studio 2022 solution (for IDE debugging)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "posix-debug",
      "displayName": "macOS / Linux Debug (Ninja + Clang or GCC)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DEFJAM_VERBOSE_KERNEL": "ON"
      }
    },
    {
      "name": "posix-release",
      "displayName": "macOS / Linux Release (Ninja + Clang or GCC)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "ci-runtime-only",
      "displayName": "CI: runtime libraries only, no game code",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DEFJAM_BUILD_GAME": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-x64-debug",
      "configurePreset": "win-x64-debug"
    },
    {
      "name": "win-x64-abicheck",
      "configurePreset": "win-x64-abicheck"
    },
    {
      "name": "win-x64-release",
      "configurePreset": "win-x64-release"
    },
    {
      "name": "win-vs2022",
      "configurePreset": "win-vs2022",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "posix-debug",
      "configurePreset": "posix-debug"
    },
    {
      "name": "posix-release",
      "configurePreset": "posix-release"
    },
    {
      "name": "ci-runtime-only",
      "configurePreset": "ci-runtime-only"
    }
  ]
}
